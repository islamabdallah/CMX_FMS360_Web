</div>

@if(Model.TripGroup!=null)
{
    foreach(var item in Model.TripGroup)
    {
        <div class="row">
            <div class="col-lg-12 mb-4 order-0">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Parent Trip # @item.ParentTrip</h5>
                        <small class="text-muted float-end"># @item.Trips.Count</small>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-4 col-lg-4 mb-3">

                                <p>Parent Number: <code class="language-plaintext highlighter-rouge" id="Naa">@item.ParentTrip </code></p>
                            </div>

                            <div class="col-4 col-lg-4 mb-3">
                                <p>
                                    Truck Number: <code class="language-plaintext highlighter-rouge" id="Stt">
                                        @item.Trips[0].TruckNumber
                                    </code>
                                </p>
                            </div>

                            <div class="col-4 col-lg-4 mb-3">
                                <p>
                                    Silo Number: <code class="language-plaintext highlighter-rouge" id="Stt">
                                        @item.Trips[0].SiloNumber
                                    </code>
                                </p>
                            </div>


                        </div>

                        <div class="row g-3">
                            <div class="col-6 col-lg-6 mb-3">
                                <label class="form-label" for="driversNumber">OnRoad Drivers</label>
                                @Html.ListBoxFor(
                                         model => item.OnRoadDrivers,                          // collection of selected IDs in your model
                                         ViewBag.DriverSelectList as List<SelectListItem>,      // list of all drivers
                                         new { @class = "form-select", @id = "OnRoadDrivers", required = "required", @disabled = "disabled" }
                                         )
                            </div>

                            <div class="col-6 col-lg-6 mb-3">
                                <br />
                             
                                <button type="button" class="btn btn-primary"
                                        onclick="openAddDriverModal('@item.ParentTrip', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(item.OnRoadDrivers)))">
                                    Add Drivers
                                </button>

                               
                            </div>

                        </div>

                        <br />
                        <hr />
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <h5 class="mb-0">Group of Trips</h5>
                           
                        </div>
                        <div class="row g-3">
                            <div class="table-responsive-sm">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Trip Number</th>
                                            <th>Parent Type</th>
                                                    <th>Trip Type</th>
                                            <th>Stage</th>
                                            <th>Departure date</th>
                                             <th>From</th>
                                            <th>To</th>
                                            <th>Quantity</th>
                                            <th></th>
                                            @*  <th>Example</th>
                            <th>Example</th>
                            <th>Example</th> *@
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (item.Trips.Count > 0)
                                        {
                                            foreach(var trip in item.Trips)
                                            {
                                                <tr>
                                                    <td>@trip.Id</td>
                                                    <td>@trip.TripNumber</td>
                                                                    <td>
                                                        @(
                                                                trip.TypeId == 1 || trip.TypeId == 2
                                                                ? ((GeneralMaterial)trip.TypeId).ToString()
                                                                : "Mission"
                                                                )
                                                                    </td>
                                                    <td>
                                                        @(
                                                            trip.SubTypeId == 1 || trip.SubTypeId == 2
                                                            ? ((GeneralMaterial)trip.SubTypeId).ToString()
                                                            : "Mission"
                                                            )
                                                    </td>
                                                    <td>@trip.StageEn</td>
                                                    <td>@trip.departureDate</td>
                                                    <td>
                                                        @(
                                                            trip.SubTypeId == 1 
                                                            ? "Plant"
                                                            : "Assuit"
                                                            )
                                                    </td>
                                                    <td>
                                                        Assuit
                                                    </td>
                                                                    <td>@trip.Qty</td>
                                                   
                                                   @*  <td><a href="#" class="card-link" hidden>View Details</a></td> *@
                                                    <td><a asp-controller="Trip" asp-action="TripConvertDetails" asp-route-id="@trip.Id" class="card-link">Edit</a></td>
                                                    @* <td>Yes</td>
                            <td>Yes</td>
                            <td>Yes</td> *@
                                                </tr>
                                            }
                                        }
                                       
                                    </tbody>
                                </table>
                            </div>

                            <div class="col-12 mb-3">
                                <button type="submit" class="btn btn-primary" onclick="Create(@item.ParentTrip,@item.Trips[0].TypeId,@item.Trips[0].SubTypeId)">Create SubTrip</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
           
        </div>
    }
}


