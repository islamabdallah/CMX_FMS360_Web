                                         new { @class = "form-select", @id = "loadDrivers" }
                                         )                              

                            </div>
                          

                            <div class="col-6 col-lg-6 mb-3">
                                <label class="form-label" for="onRoadDrivers">OnRoad Drivers</label>
                                @Html.DropDownListFor(
                                         model => model.onRoadDrivers,
                                         ViewBag.DriverSelectList as List<SelectListItem>,
                                         new { @class = "form-select", @id = "onRoadDrivers", multiple = "multiple", required = "required" }
                                         )
                            </div>
                            <div class="col-6 col-lg-4 mb-3">
                                <label class="form-label" for="Sourse">Source</label>
                                <input id="SelectedEmployeeNumbers22" value="" hidden />


                                                <select class="form-control form-select col-md-1" id="multiSelect22" name="multiSelect22[]" multiple="multiple" style="width: 100%;" asp-items="@(new SelectList(Model.JobSites, "Id", "Desc"))">
                                                <option value="-1" disabled>Select Destination</option>
                                                </select>
                               
                            </div>
                           
                            <div class="col-12 col-lg-12 mb-3" id="lmtableDiv22" hidden>
                        <div class="form-group" id="lmtable22">
                            <label for="recipient-name" class="col-form-label">Source Locations Details:</label>
