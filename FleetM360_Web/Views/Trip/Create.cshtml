@if(Model.TripGroup!=null)
{
    foreach(var item in Model.TripGroup)
    {
        <div class="row">
            <div class="col-lg-12 mb-4 order-0">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Parent Trip # @item.ParentTrip</h5>
                        <small class="text-muted float-end"># @item.Trips.Count</small>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="table-responsive-sm">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Trip Number</th>
                                            <th>Parent Type</th>
                                                    <th>Trip Type</th>
                                            <th>Stage</th>
                                            <th>Departure date</th>
                                             <th>From</th>
                                            <th>To</th>
                                            <th>Quantity</th>
                                            <th></th>
                                            @*  <th>Example</th>
                            <th>Example</th>
                            <th>Example</th> *@
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (item.Trips.Count > 0)
                                        {
                                            foreach(var trip in item.Trips)
                                            {
                                                <tr>
                                                    <td>@trip.Id</td>
                                                    <td>@trip.TripNumber</td>
                                                                    <td>
                                                        @(
                                                                trip.TypeId == 1 || trip.TypeId == 2
                                                                ? ((GeneralMaterial)trip.TypeId).ToString()
                                                                : "Mission"
                                                                )
                                                                    </td>
                                                    <td>
                                                        @(
                                                            trip.SubTypeId == 1 || trip.SubTypeId == 2
                                                            ? ((GeneralMaterial)trip.SubTypeId).ToString()
                                                            : "Mission"
                                                            )
                                                    </td>
                                                    <td>@trip.StageEn</td>
                                                    <td>@trip.departureDate</td>
                                                    <td>
                                                        @(
                                                            trip.SubTypeId == 1 
                                                            ? "Plant"
                                                            : "Assuit"
                                                            )
                                                    </td>
                                                    <td>
                                                        Assuit
                                                    </td>
                                                                    <td>@trip.Qty</td>
                                                   
                                                    <td><a href="#" class="card-link" hidden>View Details</a></td>
                                                    @* <td>Yes</td>
                            <td>Yes</td>
                            <td>Yes</td> *@
                                                </tr>
                                            }
                                        }
                                       
                                    </tbody>
                                </table>
                            </div>

                            <div class="col-12 mb-3">
                                <button type="submit" class="btn btn-primary" onclick="Create(@item.ParentTrip)">Create SubTrip</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
           
        </div>
    }
}


