@model FleetM360_PLL.ViewModels.TripModel
@using static FleetM360_PLL.CommanData;

@* <div class="container mt-3"> *@
<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Trip /</span> Create Trip</h4>


<div class="row">
    <div class="col-lg-12 mb-4 order-0">
        <div class="card">
            <div class="d-flex align-items-end row">
                <div class="col-sm-7">
                    <div class="card-body">
                        @*  <form class="row g-3" asp-action="Create"> *@
                        @using (Html.BeginForm("Create", "Trip", FormMethod.Post, new { id = "truckForm" }))
                        {


                            <h5 class="card-title text-primary">Truck Details</h5>
                            <p class="mb-4">
                                You have done <span class="fw-bold">72%</span> more sales today. Check your new badge in
                                your profile.
                            </p>
                            <div class="col-6 col-lg-4 mb-3">
                                <label for="TruckNumber" class="form-label">Example select</label>
                                @*  <select onchange="test()" asp-for="TruckId" id="TruckId" class="form-select" aria-label="Default select example" asp-items="@(new SelectList(Model.Trucks, "Id", "TruckNumber"))">
                                <option value="-1" selected disabled>Select Truck</option>
                            </select> *@
                                @Html.DropDownListFor(
                                                                             model => model.TruckId,
                                                                             new SelectList(Model.Trucks, "Id", "TruckNumber"),
                                                                             "Select Truck",
                                                                             new { @class = "form-select", @id = "TruckId", onchange = "this.form.submit();" }
                                                                             )
                            </div>


                            <div class="col-12">
                                <button type="submit" class="btn btn-sm btn-outline-primary">Add</button>
                            </div>
                        }
                        @* </form> *@
                    </div>
                </div>
                <div class="col-sm-5 text-center text-sm-left">
                    <div class="card-body pb-0 px-0 px-md-4">
                        <img src="~/sneat/assets/img/illustrations/man-with-laptop-light.png"
                        height="140"
                        alt="View Badge User"
                        data-app-dark-img="illustrations/man-with-laptop-dark.png"
                        data-app-light-img="illustrations/man-with-laptop-light.png" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Revenue -->
    <div class="col-12 col-lg-12 order-2 order-md-3 order-lg-2 mb-4">
        <div class="card">
            <div class="row row-bordered g-0">
                <div class="col-md-12">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Create Parent Trip</h5>
                        <small class="text-muted float-end">assign trip to truk</small>
                    </div>
                    <div class="card-body">
                        <form class="row g-3" asp-action="Create">
                            <div class="col-6 col-lg-4 mb-3">
                                <label class="form-label" for="basic-icon-default-fullname">Trip Type</label>
                                <select id="inputState" class="form-select">
                                    <option selected>Select Type...</option>
                                    <option value="1">Cement</option>
                                    <option value="2">Backhauling</option>
                                    <option value="3">Mission</option>
                                </select>
                            </div>
                            <div class="col-6 col-lg-4 mb-3" hidden>
                                <label class="form-label" for="basic-icon-default-fullname">Mission Type</label>
                                <select id="inputState" class="form-select">
                                    <option selected>Select Type...</option>
                                    <option value="3">Transportation</option>
                                    <option value="4">External Workshop</option>
                                    <option value="2">Maintainance</option>
                                </select>
                            </div>
                            <div class="col-6 col-lg-4 mb-3">
                                <label class="form-label" for="loadDrivers">Loading Drivers</label>
                               @*  <select asp-for="loadDrivers" id="inputState" class="form-select" aria-label="Default select example" asp-items="@(new SelectList(Model.Drivers, "DriverNumber", "DriverNumber"))">
                                    <option value="-1" selected disabled>Select driver</option>
                                </select> *@
                                @Html.DropDownListFor(
                                         model => model.loadDrivers,
                                         new SelectList(Model.Drivers, "DriverNumber", "DriverNumber"),
                                         "Select Drivers",
                                         new { @class = "form-select", @id = "loadDrivers" }
                                         )
                                @*  <button type="button" id="clearSelections" class="btn btn-danger">Clear Selections</button> *@

                            </div>
                            <div class="col-6 col-lg-4 mb-3">
                                <label class="form-label" for="onRoadDrivers">OnRoad Drivers</label>
                               @*  <select asp-for="onRoadDrivers" id="onRoadDrivers" class="form-select" aria-label="Default select example" asp-items="@(new SelectList(Model.Drivers, "DriverNumber", "DriverNumber"))">
                                    <option value="-1" selected disabled>Select driver</option>
                                </select> *@
                                @Html.DropDownListFor(
                                         model => model.onRoadDrivers,
                                         new SelectList(Model.Drivers, "DriverNumber", "DriverNumber"),
                                         "Select Drivers",
                                         new { @class = "form-select", @id = "onRoadDrivers" }
                                         )
                                
                                @*  <button type="button" id="clearSelections" class="btn btn-danger">Clear Selections</button> *@

                            </div>
                            <div class="col-6 col-lg-4 mb-3">
                                <label class="form-label" for="Sourse">Source</label>
                               @*  <select asp-for="Sourse" id="Sourse" class="form-select" aria-label="Default select example" asp-items="@(new SelectList(Model.JobSites, "Id", "Desc"))">
                                    <option value="-1" selected disabled>Select Source</option>
                                </select> *@
                                @Html.DropDownListFor(
                                         model => model.Sourse,
                                         new SelectList(Model.JobSites, "Id", "Desc"),
                                         "Select Sourse",
                                         new { @class = "form-select", @id = "Sourse" }
                                         )

                                        
                            </div>
                           
                           
                           
                            <div class="col-6 col-lg-4 mb-3">
                                <label for="Distination" class="form-label">Example select</label>
                               @*  <select asp-for="Distination" class="form-select" id="exampleFormControlSelect1" aria-label="Default select example">
                                    <option selected>Open this select menu</option>
                                    <option value="1">One</option>
                                    <option value="2">Two</option>
                                    <option value="3">Three</option>
                                </select> *@
                                                                      
                                           <input id="SelectedEmployeeNumbers" value="" hidden />


                                                <select class="form-control form-select col-md-1" id="multiSelect" name="multiSelect[]" multiple="multiple" style="width: 100%;" asp-items="@(new SelectList(Model.JobSites, "Id", "Desc"))">
                                                <option value="-1" selected disabled>Select Destination</option>
                                                </select>
                            </div>
                            <div class="col-6 col-lg-4 mb-3">
                                <label class="form-label" for="Qty">Quantity</label>
                                <div class="input-group input-group-merge">
                                    @* <span class="input-group-text"><i class="bx bx-envelope"></i></span> *@
                                    <input type="number"
                                           id="basic-icon-default-email"
                                           class="form-control"
                                           placeholder="Qty"
                                           aria-label="john.doe"
                                           aria-describedby="basic-icon-default-email2" />
                                    @*  <span id="basic-icon-default-email2" class="input-group-text">example.com</span> *@
                                </div>
                                @*  <div class="form-text">You can use letters, numbers & periods</div> *@
                            </div>
                            @*  <button type="submit" class="btn btn-primary">Send</button> *@
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Create Trip</button>
                            </div>
                        </form>
                    </div>

                </div>

            </div>
        </div>
    </div>
    <!--/ Total Revenue -->

</div>

@if(Model.TripGroup!=null)
{
    foreach(var item in Model.TripGroup)
    {
        <div class="row">
            <div class="col-lg-12 mb-4 order-0">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Parent Trip # @item.ParentTrip</h5>
                        <small class="text-muted float-end"># @item.Trips.Count</small>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="table-responsive-sm">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Trip Number</th>
                                            <th>type</th>
                                            <th>Stage</th>
                                            <th>Departure date</th>
                                            <th>arrive date</th>
                                            <th>Sourse</th>
                                            <th>Destination</th>
                                            <th></th>
                                            @*  <th>Example</th>
                            <th>Example</th>
                            <th>Example</th> *@
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (item.Trips.Count > 0)
                                        {
                                            foreach(var trip in item.Trips)
                                            {
                                                <tr>
                                                    <td>@trip.Id</td>
                                                    <td>@trip.TripNumber</td>
                                                    <td>
                                                        @(
                                                            trip.SubTypeId == 1 || trip.SubTypeId == 2
                                                            ? ((GeneralMaterial)trip.SubTypeId).ToString()
                                                            : "Mission"
                                                            )
                                                    </td>
                                                    <td>@trip.StageEn</td>
                                                    <td>@trip.departureDate</td>
                                                    <td>@trip.ArrivedDate</td>
                                                    <td>Plant</td>
                                                    <td>Assuit</td>
                                                    <td><a href="#" class="card-link">View Details</a></td>
                                                    @* <td>Yes</td>
                            <td>Yes</td>
                            <td>Yes</td> *@
                                                </tr>
                                            }
                                        }
                                       
                                    </tbody>
                                </table>
                            </div>

                            <div class="col-12 mb-3">
                                <button type="submit" class="btn btn-primary">Create SubTrip</button>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
            <div class="col-xl" hidden>
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Basic with Icons</h5>
                        <small class="text-muted float-end">Merged input group</small>
                    </div>
                    <div class="card-body">
                        <form>
                            <div class="col-md-4">
                                <label for="inputEmail4" class="form-label">Select Truck</label>
                                <select onchange="test()" asp-for="TruckNumber" id="TruckId" class="form-control select2bs4" asp-items="@(new SelectList(Model.Trucks, "TruckNumber", "TruckNumber"))">
                                    <option value="-1" selected disabled>Select Truck</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="inputPassword4" class="form-label">Truck Silo information</label><br />
                                <label for="inputPassword4" class="form-label">truck123 --------------------> silo123</label>
                                <a class="btn btn-primary">assign silo</a>
                            </div>
                            <div class="col-md-4">
                                <label for="inputEmail4" class="form-label">Select Silo</label>
                                <select id="inputState" class="form-select">
                                    <option selected>Choose Silo...</option>
                                    <option value="1">Silo123</option>
                                    <option value="2">Silo124</option>
                                    <option value="3">Silo125</option>
                                    <option value="4">Silo126</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="inputEmail4" class="form-label">Select Driver</label>
                                <select id="inputState" class="form-select">
                                    <option selected>Choose Driver...</option>
                                    <option value="1">Driver123</option>
                                    <option value="2">Driver124</option>
                                    <option value="3">Driver125</option>
                                    <option value="4">Driver126</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="inputEmail4" class="form-label">Select Role</label>
                                <select id="inputState" class="form-select">
                                    <option selected>Choose Role...</option>
                                    <option value="1">Loading</option>
                                    <option value="2">OnRoad</option>
                                    <option value="3">CooDriver</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label for="inputEmail4" class="form-label">Assigned Drivers</label>
                                <table class="w-100">
                                    <tr>
                                        <th>Driver</th>
                                        <th>Role</th>
                                    </tr>
                                    <tbody>
                                        <tr>
                                            <td>Driver123</td>
                                            <td>Loading</td>
                                        </tr>
                                        <tr>
                                            <td>Driver124</td>
                                            <td>OnRoad</td>
                                        </tr>
                                        <tr>
                                            <td>Driver125</td>
                                            <td>CooDriver</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                            <div class="col-4">
                                <label for="inputAddress" class="form-label">Trip Type</label>

                            </div>
                            <div class="col-4">
                                <label for="inputAddress2" class="form-label">Material</label>
                                <input type="text" class="form-control" id="inputAddress2" placeholder="Cement, RDF, or others">
                            </div>
                            <div class="col-md-4">
                                <label for="inputCity" class="form-label">QTY</label>
                                <input type="text" class="form-control" id="inputCity">
                            </div>
                            <div class="col-6">
                                <label for="inputAddress" class="form-label">Source</label>
                                <select id="inputState" class="form-select">
                                    <option selected>Select Type...</option>
                                    <option value="1">Site1</option>
                                    <option value="2">Site2</option>
                                    <option value="3">Site3</option>
                                    <option value="4">Site4</option>
                                </select>
                            </div>
                            <div class="col-6">
                                <label for="inputAddress" class="form-label">Destination</label>
                                <select id="inputState" class="form-select">
                                    <option selected>Select Type...</option>
                                    <option value="1">Site1</option>
                                    <option value="2">Site2</option>
                                    <option value="3">Site3</option>
                                    <option value="4">Site4</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <button type="submit" class="btn btn-primary">Add</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
}


           
   


