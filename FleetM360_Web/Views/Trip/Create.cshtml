@section Scripts {
    <script>
        $(document).ready(function() {
            $('#TruckId1').select2({
                placeholder: 'Select trucks',
                width: '100%'
            });
        });
    </script>

    <script>
        function test() {
            console.log("welcome");
            var ddlsource = document.getElementById("TruckId").value;
            console.log(ddlsource);
            if (ddlsource != -1) {
                var url = '@Url.Content("../")' + "Trip/IsTruckAvaliable";
                $.getJSON(url, { truckId: ddlsource }, function (data) {
                    if (data != null) {
                        alert(data);
                        //$('#DriverId').val('-1').change();
                        $("#TruckId").prop("selectedIndex", -1);
                    }
                });
            }
        }
    </script>
    <script>
            document.getElementById("clearSelections").addEventListener("click", function() {
            var selectElement = document.getElementById("TruckId1");
            for (var i = 0; i < selectElement.options.length; i++) {
                selectElement.options[i].selected = false;
            }
        });

    </script>
}
