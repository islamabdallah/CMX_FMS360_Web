@model IEnumerable<FleetM360_DAL.Models.MasterModels.SapTrip>
@using static FleetM360_PLL.CommanData;

@* <div class="container mt-3"> *@
<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Trip /</span> Pending SapTrip</h4>



@if (Model != null)
{
   
        <div class="row">
            <div class="col-lg-12 mb-4 order-0">
                <div class="card mb-4">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Pending Sap Trips</h5>
                        <small class="text-muted float-end">Need Approve</small>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="table-responsive-sm">
                                <table class="table table-bordered">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>Trip Number</th>
                                            <th>Truck Number</th>
                                            <th>Qty</th>
                                            <th>JobSite Number</th>
                                            
                                            <th></th>
                                            @*  <th>Example</th>
                            <th>Example</th>
                            <th>Example</th> *@
                                        </tr>
                                    </thead>
                                    <tbody>
                                       
                                            @foreach (var trip in Model)
                                            {
                                                <tr>
                                                    <td>@trip.Id</td>
                                                    <td>@trip.TripNumber</td>
                                                    <td>
                                                        @trip.TruckNumber
                                                    </td>
                                                    <td>@trip.Qty</td>
                                                    <td>@trip.jobsiteNumber</td>

                                            <td><a asp-controller="Trip" asp-action="EditSapTrip" asp-route-id="@trip.Id" class="card-link">Edit</a></td>
                                                   
                                                </tr>
                                            }
                                        

                                    </tbody>
                                </table>
                            </div>

                          
                        </div>

                    </div>
                </div>
            </div>
           
        </div>
   
}






@section Scripts {

   
}
