@section Scripts {

    <script>
        function getLocation() {
               $(".TimeInfo").remove();
               var url = '@Url.Content("~/")' + "Truck/getLocations";
               $.getJSON(url, function (result) {
                   if (result != null) {
                       alert("welcome");
                            //Create Options or set different Characteristics of Google Map
                            var mapOptions = {
                           center: new google.maps.LatLng(result[0].Lat, result[0].Long),
                               zoom: 9,
                               mapTypeId: google.maps.MapTypeId.ROADMAP
                           };

                           //Display the Google map in the div control with the defined Options
                           var map = new google.maps.Map(document.getElementById("map"), mapOptions);
        for (let i = 0; i < result.length; i++) {

                           //Set the Latitude and Longitude of the Map
                           var myAddress = new google.maps.LatLng(result[i].Lat, result[i].Long);
                           //Set Marker on the Map
                           var marker = new google.maps.Marker({
                           position: myAddress,
                           animation: google.maps.Animation.BOUNCE,
                               color: 'green',
                               //icon: x,
                               map:map,
                           });

                           marker.setMap(map);

                           google.maps.event.addListener(marker, 'click', (function (marker) {return function () {
                           console.log('called');
                                   console.log(result[i].TruckNumber);
                                   console.log(result.length);
                                   var Infocontent =
                                          ('<p>' + 'TruckNumber: ' + '<code class="language-plaintext highlighter-rouge">' + result[i].TruckNumber + '</code>' + '</p>'
                                          +'<p>' + 'Date: ' + '<code class="language-plaintext highlighter-rouge">' + result[i].Date + '</code>' + '</p>'
                                          +'<p>' + 'Status: ' + '<code class="language-plaintext highlighter-rouge">' + result[i].Status + '</code>' + '</p>');// result[i].UserName;
                           infowindow = new google.maps.InfoWindow();
                           infowindow.setContent(Infocontent);
                           infowindow.open(map, marker); //'mouseover'
                           }
                           })(marker));

                           marker.setMap(map);
                       }

                       //$('#modal-report').modal('show');
                       // $('#Vessel-Detailes').modal('show');

                   }
                   else {
                      // document.getElementById("msg2").innerHTML = "No Location";

                   }
               })
              // $('#modal-report').modal('show');

           }

    </script>
    <script>
          var connection = new signalR.HubConnectionBuilder()
            .withUrl("/truckHub") // Change to your backend URL
            .build();

        connection.start().catch(function (err) {
            return console.error(err.toString());
        });//.catch (err => console.error(err.toString()));

        connection.on("ReceiveTruckLocation", function (truckId, latitude, longitude) {
            console.log(truckId);
            //var position = { lat: latitude, lng: longitude };

             getLocation();
        });
        </script>
    <script>
        $(document).ready(function () {
            getLocation();
        });

    </script>

