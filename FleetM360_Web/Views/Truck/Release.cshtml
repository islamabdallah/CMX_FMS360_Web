@model IEnumerable<FleetM360_DAL.Models.MasterModels.Truck>
@using static FleetM360_PLL.CommanData;

@* <div class="container mt-3"> *@
<h4 class="fw-bold py-3 mb-4"><span class="text-muted fw-light">Trip /</span> Pending SapTrip</h4>



@if (Model != null)
{

    <div class="row">
        <div class="col-lg-12 mb-4 order-0">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Failed Trucks</h5>
                    <small class="text-muted float-end">Need Release from Maintenance</small>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="table-responsive-sm">
                            <table class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Truck Number</th>
                                        <th>SapKey</th>
                                        <th>Category</th>
                                        <th>LicenceNumber</th>

                                        <th></th>
                                        @*  <th>Example</th>
                            <th>Example</th>
                            <th>Example</th> *@
                                    </tr>
                                </thead>
                                <tbody>

                                    @foreach (var trip in Model)
                                    {
                                        <tr>
                                            <td>@trip.Id</td>
                                            <td>@trip.TruckNumber</td>
                                            <td>
                                                @trip.SapKey
                                            </td>
                                            <td>@trip.Category</td>
                                            <td>@trip.LicenceNumber</td>

                                            <td><a asp-controller="Truck" asp-action="ReleaseTruck" asp-route-id="@trip.Id" class="card-link">Release</a></td>

                                        </tr>
                                    }


                                </tbody>
                            </table>
                        </div>


                    </div>

                </div>
            </div>
        </div>

    </div>

}






@section Scripts {


}
